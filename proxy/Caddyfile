:8888 {
    # Flask backend API paths
    handle /flask/* {
        reverse_proxy {$BACKEND_SERVICE} {
            health_uri /flask/hello
        }
    }

    # Root path handling for Node.js frontend/main app
    handle * {
        reverse_proxy {$WEB_SERVICE}
    }

    # Enable logging
    log {
        output stdout
        format json
    }
}