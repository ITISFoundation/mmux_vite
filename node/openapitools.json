{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.14.0",
    "generators": {
      "v3.0": {
        "generatorName": "typescript",
        "inputSpec": "openapi.json",
        "output": "src/osparc-api-ts-client",
        "additionalProperties": {
          "npmName": "osparc-api-ts-client",
          "supportsES6": true,
          "npmVersion": "11.3.0",
          "withInterfaces": true
        }
      }
    }
  }
}
