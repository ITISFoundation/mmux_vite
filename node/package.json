    "@mui/styled-engine-sc": "^9.4.0",
    "@mui/x-data-grid": "^9.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "plotly.js": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plotly.js": "^4.1.0",
    "react-toastify": "^11.1.0",
    "styled-components": "^6.5.3",
    "superagent": "^10.3.0",
