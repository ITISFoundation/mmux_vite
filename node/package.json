{
  "name": "mmux_vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-osparc-cli && tsc -b && vite build",
    "build:e2e": "npm run generate-osparc-cli && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npx vitest",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:e2e": "NODE_PATH=\"$PWD/node_modules\" playwright test",
    "test:e2e:update": "NODE_PATH=\"$PWD/node_modules\" playwright test --update-snapshots",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "generate-osparc-cli": "openapi-generator-cli generate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/styled-engine-sc": "^7.0.2",
    "@mui/x-data-grid": "^8.4.0",
    "@tailwindcss/vite": "^4.1.6",
    "plotly.js": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "^2.6.0",
    "react-toastify": "^11.0.5",
    "styled-components": "^6.1.17",
    "superagent": "^10.2.0",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-plotly.js": "^2.6.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.2.5",
    "@vitest/coverage-v8": "^3.2.5",
    "@vitest/ui": "^3.2.5",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.1",
    "postcss": "^8.5.3",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.5",
    "vitest-browser-react": "^1.0.1"
  },
  "proxy": "http://localhost:5000",
  "engines": {
    "node": ">=24.0.0"
