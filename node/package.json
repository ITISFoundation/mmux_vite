    "test:e2e:update": "NODE_PATH=\"$PWD/node_modules\" playwright test --update-snapshots",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "generate-osparc-cli": "openapi-generator-cli generate"
  },
  "dependencies": {
