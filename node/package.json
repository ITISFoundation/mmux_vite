{
  "name": "mmux_vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-osparc-cli && tsc -b && vite build",
    "build:e2e": "npm run generate-osparc-cli && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npx vitest",
